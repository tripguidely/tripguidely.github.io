name: NWS NYC shadow collection - future template only
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: nws-nyc-shadow
  cancel-in-progress: false
jobs:
  shadow:
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0
        with:
          python-version: '3.12'
      - name: Collect once into temporary shadow output
        shell: bash
        run: |
          python -B scripts/nws-travel-alerts.py --live --state "$RUNNER_TEMP/nws-shadow-state" --output "$RUNNER_TEMP/nws-shadow-output"
          python -c 'import json,os; p=os.path.join(os.environ["RUNNER_TEMP"],"nws-shadow-output","review.json"); d=json.load(open(p)); print("NWS shadow status:",d["status"],"qualified:",d.get("qualified",0)); raise SystemExit(0 if d["status"]=="checked" else 1)'
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        if: always()
        with:
          name: nws-shadow-review
          path: ${{ runner.temp }}/nws-shadow-output/
          retention-days: 7
          if-no-files-found: error
# Intentionally stored under docs/workflows with a .example suffix.
# No schedule, Pages deployment or Git writer. Artifacts are not durable state.
